<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/space_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#4D000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/mainLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp"
            android:visibility="gone">

            <!-- CardView Tiêu đề -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="40dp"
                app:cardBackgroundColor="#CC0A0A14"
                app:cardCornerRadius="20dp"
                app:cardElevation="15dp"
                app:cardUseCompatPadding="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="28dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PROCTY"
                        android:textColor="#00D2FF"
                        android:textSize="42sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.2"
                        android:shadowColor="#5500D2FF"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="20" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="ASSIST COMMAND CENTER"
                        android:textColor="#9D4EDD"
                        android:textSize="12sp"
                        android:letterSpacing="0.15" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Nút Kiểm tra Shizuku -->
            <Button
                android:id="@+id/btnCheckShizuku"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="20dp"
                android:background="#1A2A3A"
                android:text="🔍 KIỂM TRA SHIZUKU"
                android:textColor="#00D2FF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

            <!-- Nút Khởi chạy -->
            <Button
                android:id="@+id/btnStartProcTy"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="20dp"
                android:background="#00D2FF"
                android:text="⚡ KHỞI CHẠY HỆ THỐNG"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold"
                android:stateListAnimator="@null" />

        </LinearLayout>
    </ScrollView>

    <!-- Loading Layout -->
    <LinearLayout
        android:id="@+id/loadingLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E605050A"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:indeterminateTint="#00D2FF"
            android:indeterminateTintMode="src_in" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="PROCTY SYSTEM"
            android:textColor="#9D4EDD"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.3"
            android:shadowColor="#559D4EDD"
            android:shadowRadius="15"
            android:shadowDx="0"
            android:shadowDy="0" />

        <TextView
            android:id="@+id/tvLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Đang khởi tạo..."
            android:textColor="#00E676"
            android:textSize="14sp"
            android:fontFamily="monospace" />
    </LinearLayout>

</RelativeLayout>
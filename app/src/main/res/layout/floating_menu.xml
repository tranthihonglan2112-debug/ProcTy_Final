<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="10dp">

    <!-- Nút ON/OFF chính -->
    <TextView
        android:id="@+id/btnToggle"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="OFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#88FFFFFF"
        android:background="@drawable/bg_neon_off"
        android:shadowColor="#000000"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Nút mở rộng Menu (Hình dấu X) -->
    <TextView
        android:id="@+id/btnExpand"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:text="X"
        android:textColor="#FFFFFF"
        android:background="#55000000"
        android:textStyle="bold"
        android:visibility="visible" />

    <!-- Menu ẩn chứa thanh trượt và nút Gần/Xa -->
    <LinearLayout
        android:id="@+id/menuOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_button_secondary" 
        android:padding="15dp"
        android:layout_marginTop="10dp"
        android:visibility="gone">

        <!-- Tiêu đề và số Pixel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="5dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Lực bù trừ"
                android:textColor="#00D2FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Text hiển thị số Pixel hiện tại -->
            <TextView
                android:id="@+id/tvPixelValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40 px"
                android:textColor="#00FF00"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/seekBarPx"
            android:layout_width="180dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="40"
            android:progressTint="#00D2FF"
            android:thumbTint="#00D2FF" />

        <!-- 2 nút Gần / Xa -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp">

            <Button
                android:id="@+id/btnNear"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="45dp"
                android:text="GẦN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#00FF00"
                android:background="@drawable/bg_neon_on"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/btnFar"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="XA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#00D2FF"
                android:background="@drawable/bg_neon_off"
                android:stateListAnimator="@null" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
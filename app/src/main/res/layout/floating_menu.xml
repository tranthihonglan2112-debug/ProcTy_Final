<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <!-- Thanh công cụ nhỏ (Luôn hiển thị) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nút ON/OFF -->
        <TextView
            android:id="@+id/btnToggle"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="OFF"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_floating_button_off"
            android:elevation="8dp" />

        <!-- Nút Thu nhỏ / Bung ra (Hình vuông bo góc) -->
        <TextView
            android:id="@+id/btnExpand"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:text="≡"
            android:textColor="#00D2FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:background="@drawable/bg_button_secondary"
            android:elevation="8dp" />
    </LinearLayout>

    <!-- Bảng chọn chế độ (Ẩn/Hiện) -->
    <LinearLayout
        android:id="@+id/menuOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical"
        android:background="#CC0A0A14"
        android:padding="8dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHỌN CHẾ ĐỘ QUÉT"
            android:textColor="#9D4EDD"
            android:textSize="10sp"
            android:gravity="center"
            android:layout_marginBottom="4dp" />

        <Button
            android:id="@+id/btnModeColor"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="1. Chọn Màu"
            android:textColor="#00D2FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeTemplate"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_button_secondary"
            android:text="2. Ảnh Mẫu"
            android:textColor="#00D2FF"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnModeCapture"
            android:layout_width="150dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_primary"
            android:text="3. Chụp Ảnh"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>